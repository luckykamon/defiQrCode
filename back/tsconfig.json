{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "resolveJsonModule": true,
    "strict": true,
    "target": "es2022"
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src"
  ],
  "lib": [
    "es2022"
  ]
}
